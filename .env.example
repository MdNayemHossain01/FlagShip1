# FlagShip Local & Offline-Ready Configuration (Requirement C1: Zero Paid Cloud Dependencies)

# Server port
PORT="3000"

# JWT Secrets for FlagShip authentication (override in production)
JWT_SECRET="flagship-local-jwt-secret-change-in-production-32chars"
JWT_REFRESH_SECRET="flagship-local-refresh-secret-change-in-production"

# Local Embedded PostgreSQL (PGlite) data directory (default when PGHOST/DATABASE_URL are unset)
FLAGSHIP_DATA_DIR=".flagship-data/pgdata"

# Optional: Connect to a local or Docker PostgreSQL 16 instance instead of embedded PGlite
# PGHOST="localhost"
# PGPORT="5432"
# PGDATABASE="flagship"
# PGUSER="flagship_app"
# PGPASSWORD="flagship_dev_pass"
